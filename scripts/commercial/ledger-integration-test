#!/usr/bin/env bash
# scripts/commercial/ledger-integration-test
# Repository-owned test runner for the PostgreSQL-backed commercial ledger.
# Executes the comprehensive ledger integration test suite and asserts invariants.
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"

DATABASE_URL="${DATABASE_URL:-}"

while (($#)); do
    case "$1" in
        --database-url)
            (($# >= 2)) || { echo "error: --database-url requires an argument" >&2; exit 2; }
            DATABASE_URL="$2"
            shift 2
            ;;
        *)
            echo "unknown option: $1" >&2
            exit 2
            ;;
    esac
done

if [[ -z "${DATABASE_URL}" ]]; then
    echo "FAIL: DATABASE_URL is missing. Refusing to run tests without a real PostgreSQL target." >&2
    exit 1
fi

printf "=== Commercial Ledger Integration Test Runner ===\n"
printf "Target: PostgreSQL (URL redacted)\n"

# Execute migration and ledger property/fault/concurrency test suite
export TEST_DATABASE_URL="${DATABASE_URL}"
cd "${REPO_ROOT}"

printf "+ Running ponyllm-billing migration & ledger verification suite...\n"
cargo test -p ponyllm-billing --test pg_migrations -- --ignored --nocapture

printf "=== Ledger Integration Tests: PASSED ===\n"
exit 0
