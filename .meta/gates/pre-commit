#!/usr/bin/env bash
# ponyllm pre-commit gate (Second-level ~1-2s)
set -eo pipefail

echo "=== [pre-commit 1/3] ADR note format & lifecycle check ==="
bash .agents/skills/write-adr/verify-note.sh

echo "=== [pre-commit 2/3] ADR negative regression specs check ==="
bash .meta/gates/pre-commit.spec.sh

echo "=== [pre-commit 3/3] Fast syntax & workspace compilation check ==="
cargo check --workspace

echo "=== [pre-commit PASS] Ready to commit! ==="
