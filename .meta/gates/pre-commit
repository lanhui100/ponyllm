#!/usr/bin/env bash
# ponyllm pre-commit gate (Second-level ~1-2s)
set -eo pipefail
export PATH="/usr/bin:/bin:$PATH"

echo "=== [pre-commit 1/3] ADR note format & lifecycle check ==="
bash .agents/skills/write-adr/verify-note.sh

echo "=== [pre-commit 2/3] ADR negative regression specs check ==="
bash .meta/gates/pre-commit.spec.sh

echo "=== [pre-commit task-scope] Task system gate (only when tasks/notes staged) ==="
# 任务域门禁：仅当暂存区命中 .agents/tasks/ 或 .agents/notes/ 才跑——
# 纯代码提交不受任务树状态影响（多 worktree 并行时各树任务态本就不同步）；
# 任务触及提交必须让任务树全绿；全量兜底在 CI。
staged_tasks=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^\.agents/(tasks|notes)/' || true)
if [ -n "$staged_tasks" ]; then
  bash .meta/gates/check-tasks.sh
fi

echo "=== [pre-commit 3/3] Fast syntax & workspace compilation check ==="
cargo check --workspace

# [doc-freshness nudge] WARN 级提醒，非门禁：暂存区改了 .rs 却没带任何 .md/AGENTS.md 更新时
# 提示检查"用户可见行为是否需要同步文档"。这是启发式（纯重构/内部改动无需文档），
# 只 WARN 不 FAIL——新鲜度是语义判断，机器到不了（P6）；误报时忽略即可。
# 依据：constitution 第 4 条 same-commit + 2026-09-03-doc-backfill 复检结论。
staged_rs=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.rs$' || true)
staged_md=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '(\.md$|AGENTS\.md$)' || true)
if [ -n "$staged_rs" ] && [ -z "$staged_md" ]; then
  echo "=== [doc-freshness WARN] 暂存区有 .rs 变更但无文档更新 ===" >&2
  echo "  改了行为/契约请同步对应文档的家（README/crate README/docs/AGENTS.md，same-commit）；" >&2
  echo "  纯重构/内部改动无需文档时忽略本提示（启发式，非门禁，不阻提交）。" >&2
fi

echo "=== [pre-commit PASS] Ready to commit! ==="
