# ponygo 最小 .gitignore（栈无关）
# OS/编辑器噪声：
.DS_Store
Thumbs.db
*~
# Rust 构建产物/依赖目录：
target/
# 交叉编译（bookworm glibc 对齐）产物目录：不匹配上面的 target/ 前缀锚定，需显式忽略
target-*/
# Web 构建产物/依赖目录（pnpm-lock.yaml 必须提交，pin 可复现）：
web/dist/
web/node_modules/
# 运行期产物（随配置文件落盘，位置不固定）：
ponyllm.pid
ponyllm-serve.log
telemetry-snapshot.json
# 覆盖率与性能画像：
coverage/
lcov.info
*.profraw
*.profdata
# 调试符号（target 外兜底，target 本身已忽略）：
*.pdb
# Python 字节码缓存：
__pycache__/
*.pyc

# Agent team 内部审计产物（findings/报告/复审/红相记录，不入库）：
.dev-team/


# IDE/编辑器目录：
.idea/
.vscode/
*.swp
*.swo


# 并发会话在飞的 Python 虚拟环境（构建产物，等价于 target/ 与 node_modules/）
.venv-test/
