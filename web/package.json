{
  "name": "ponyllm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings --ignore-pattern \"node_modules/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"src/generated/**\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "alova": "3.5.5",
    "pinia": "4.0.3",
    "vue": "3.5.13",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "happy-dom": "20.14.0",
    "oxlint": "1.81.0",
    "typescript": "5.7.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "2.2.0"
  }
}
