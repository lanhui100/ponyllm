  "components": {
    "schemas": {
      "AdminPricingMode": {
        "type": "string",
        "enum": [
          "uniform",
          "peak_valley"
        ]
      },
      "AdminPricingPeriod": {
        "type": "object",
        "required": [
          "start_time",
          "end_time",
          "input_price",
          "cached_price",
          "output_price"
        ],
        "properties": {
          "cached_price": {
            "type": "number",
            "format": "double"
          },
          "end_time": {
            "type": "string"
          },
          "include_weekends": {
            "type": "boolean"
          },
          "input_price": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string"
          },
          "output_price": {
            "type": "number",
            "format": "double"
          },
          "start_time": {
            "type": "string"
          }
        }
      },
      "AntigravityAuthUrlView": {
        "type": "object",
        "required": [
          "auth_url",
          "redirect_uri",
          "state"
        ],
        "properties": {
          "auth_url": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "AntigravityPendingView": {
        "type": "object",
        "required": [
          "state",
          "ready"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "ready": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "AntigravityQuotaBucketView": {
        "type": "object",
        "required": [
          "bucket_id",
          "window",
          "remaining_fraction"
        ],
        "properties": {
          "bucket_id": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "remaining_fraction": {
            "type": "number",
            "format": "double"
          },
          "reset_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "reset_time_beijing": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_until_reset": {
            "type": [
              "string",
              "null"
            ]
          },
          "window": {
            "type": "string"
          }
        }
      },
      "AntigravityQuotaGroupView": {
        "type": "object",
        "required": [
          "display_name",
          "buckets"
        ],
        "properties": {
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AntigravityQuotaBucketView"
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "AntigravityQuotaItemView": {
        "type": "object",
        "required": [
          "model_id",
          "remaining_fraction"
        ],
        "properties": {
          "model_id": {
            "type": "string"
          },
          "remaining_fraction": {
            "type": "number",
            "format": "double"
          },
          "reset_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "reset_time_beijing": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_until_reset": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AuthorizeAntigravityPayload": {
        "type": "object",
        "required": [
          "code_or_url"
        ],
        "properties": {
          "code_or_url": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "proxy": {
            "type": [
              "string",
              "null"
            ]
          },
          "redirect_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "weight": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AuthorizeAntigravityResponse": {
        "type": "object",
        "required": [
          "provider",
          "id",
          "config_version"
        ],
        "properties": {
          "config_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "quota": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AntigravityQuotaItemView"
            }
          },
          "quota_groups": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AntigravityQuotaGroupView"
            }
          }
        }
      },
      "CreateKeyPayload": {
        "type": "object",
        "required": [
          "provider",
          "id",
          "api_key"
        ],
        "properties": {
          "api_key": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "provider": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "CreateKeyResponse": {
        "type": "object",
        "required": [
          "provider",
          "id",
          "api_key",
          "priority",
          "weight",
          "state",
          "config_version"
        ],
        "properties": {
          "api_key": {
            "type": "string"
          },
          "config_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "provider": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "CreateModelPayload": {
        "type": "object",
        "required": [
          "provider",
          "name"
        ],
        "properties": {
          "base_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "cached_price": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "context_window": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_price": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "input_types": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "max_output": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "output_price": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "output_types": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "pricing_mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AdminPricingMode"
              }
            ]
          },
          "pricing_periods": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AdminPricingPeriod"
            }
          },
          "protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string"
          },
          "proxy": {
            "type": [
              "string",
              "null"
            ]
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "format": "float"
          },
          "thinking_default": {
            "type": [
              "string",
              "null"
            ]
          },
          "thinking_max": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ],
            "format": "float"
          }
        }
      },
      "CreateProviderPayload": {
        "type": "object",
        "required": [
          "name",
          "base_url"
        ],
        "properties": {
          "base_url": {
            "type": "string"
          },
          "billing_mode": {
            "type": "string"
          },
          "cached_price": {
            "type": "number",
            "format": "double"
          },
          "chat_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_model": {
            "type": "string"
          },
          "default_protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_price": {
            "type": "number",
            "format": "double"
          },
          "messages_url": {
            "type": [
              "string",
              "null"
            ]
