# deploy/magpie/.env.example — cp .env.example .env 后填值；.env 不入库（已 gitignore）
#
# Web UI 的 key：16 个以上字母/数字/-._~，生成方式 `openssl rand -hex 16`。
# 拿到含 key 的链接的人可以改 magpie、看它的密钥，所以只给自己。
MAGPIE_WEB_KEY=

# 客户端（含其它机器上的 Agent）访问网关用的地址。
# 只本机用就保持回环；经 Tailscale 访问改成 MagicDNS 名 + 网关端口。
MAGPIE_PUBLIC_URL=http://127.0.0.1:3425

# 端口发布地址（双栈各一条：MagicDNS 同时返回 A/AAAA，只绑 v4 会先撞连接拒绝再回落）。
#   只本机：V4=127.0.0.1 / V6=::1
#   经 Tailscale：V4=$(tailscale ip -4) / V6=$(tailscale ip -6)
# 绑 tailnet 地址 = 内核层只接受来自 tailscale0 的连接，局域网/公网连端口都看不到。
MAGPIE_BIND_V4=127.0.0.1
MAGPIE_BIND_V6=::1

# 可选应用层来源白名单（magpie 用连接自身地址判定，不认 X-Forwarded-For）。
# 留空 = 不限制来源（但仍要求网关密钥）。只在必须发布到 0.0.0.0 时才需要：
#   MAGPIE_ALLOW_IPS=100.64.0.0/10,fd7a:115c:a1e0::/48
MAGPIE_ALLOW_IPS=

# 镜像 tag：latest（最新正式版）/ stable（每周一次）/ daily（一天一次）/ 具体版本号
MAGPIE_TAG=latest
